<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store channel. release.yml substitutes the
  three __PLACEHOLDERS__ and packs dist/windows + this folder with makeappx.
  The Store re-signs the package with Microsoft's certificate on submission,
  which is what lets it run with Smart App Control on; the package itself is
  uploaded unsigned and is NOT sideloadable. Identity Name/Publisher must be
  the values Partner Center shows for the reserved app name (repo variables
  MSSTORE_IDENTITY_NAME / MSSTORE_PUBLISHER) or the upload is rejected.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>GoShareIt</DisplayName>
    <PublisherDisplayName>Rake-Pro</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="GoShareIt" Executable="goshareit.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="GoShareIt"
        Description="Screenshot and screen-recording tool: capture, annotate, upload, and share from the tray."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Off by default; the user flips it in Settings > Apps > Startup. -->
        <uap5:Extension Category="windows.startupTask" Executable="goshareit.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="GoShareItStartup" Enabled="false" DisplayName="GoShareIt" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
