<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened-runtime entitlements for notarizing the GoShareIt cgo app.

  Notarization requires the Hardened Runtime (codesign -o runtime). These
  entitlements relax just enough of it for the cgo binaries while staying
  notarizable.

  Each entitlement is documented inline. Add nothing speculative: extra
  entitlements widen the attack surface and can trigger notarization warnings.

  Deliberately absent: disable-library-validation and
  allow-dyld-environment-variables. The bundle ships no dylibs or frameworks
  (cgo code is linked statically, everything loaded at run time is an Apple
  system framework), and ordinary environment variables such as the one named
  by nextcloud.password_env reach a hardened-runtime process without any
  entitlement. Together the two keys let another process inject an unsigned
  dylib (DYLD_INSERT_LIBRARIES) and borrow the app's Screen Recording
  permission.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Go compiles and links its own runtime; some toolchain/cgo configurations need
	  writable+executable mappings. Enabling this avoids hard launch failures under
	  the hardened runtime. Safe for a notarized, non-sandboxed agent app.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
