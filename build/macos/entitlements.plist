<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened-runtime entitlements for notarizing the GoShareIt cgo app.

  Notarization requires the Hardened Runtime (codesign -o runtime). These
  entitlements relax just enough of it for a cgo binary that links third-party
  C/Objective-C libraries (clipboard, hotkey, systray) while staying notarizable.

  Each entitlement is documented inline. Add nothing speculative: extra
  entitlements widen the attack surface and can trigger notarization warnings.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Allow loading libraries/frameworks not signed by Apple or the same Team ID.
	  Go's cgo links against system dylibs and the toolchain-produced objects; this
	  prevents library-validation failures at launch on a hardened-runtime build.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!--
	  Go compiles and links its own runtime; some toolchain/cgo configurations need
	  writable+executable mappings. Enabling this avoids hard launch failures under
	  the hardened runtime. Safe for a notarized, non-sandboxed agent app.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!--
	  Permit the app to read environment variables passed at launch (used for the
	  Nextcloud password via nextcloud.password_env). Without this, DYLD/JIT
	  hardening can scrub inherited environment for hardened-runtime processes.
	-->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
